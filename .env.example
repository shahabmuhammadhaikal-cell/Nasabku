# Port HTTP server (Render mengisinya otomatis).
PORT=3000

# Lingkungan: development | production
NODE_ENV=development

# Lokasi berkas SQLite. Di Render, arahkan ke Persistent Disk, misal /var/data/nasabku.db
DATABASE_PATH=./data/nasabku.db

# Umur sesi dalam hari.
SESSION_TTL_HARI=30

# Setel ke true bila dilayani lewat HTTPS, agar cookie sesi memakai flag Secure.
COOKIE_SECURE=false
