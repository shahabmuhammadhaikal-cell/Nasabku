# ===== API =====
# Port HTTP API
PORT=8080
# development | test | production
NODE_ENV=development
# LogLevel pino: trace|debug|info|warn|error|silent
LOG_LEVEL=info
# Origin web (untuk allowlist CORS dan pemeriksaan CSRF Origin)
APP_ORIGIN=http://localhost:3000
# Allowlist CORS tambahan, dipisah koma (kosongkan bila hanya APP_ORIGIN)
API_CORS_ORIGINS=
# Nama cookie sesi (HttpOnly)
SESSION_COOKIE_NAME=nasabku_session
# Umur sesi dalam jam (maks 336 = 14 hari)
SESSION_TTL_HOURS=12
# Batas body request dalam byte
BODY_LIMIT_BYTES=102400

# ===== Rate limit (in-memory, per instance) =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Lebih ketat untuk endpoint autentikasi
RATE_LIMIT_AUTH_MAX=10

# ===== Firebase =====
# true = gunakan Emulator Suite lokal (auth:9099, firestore:8080). DILARANG true di production.
USE_FIREBASE_EMULATORS=true
# ID proyek Firebase. Untuk emulator gunakan awalan "demo-" (tidak perlu login).
FIREBASE_PROJECT_ID=demo-nasabku
# Path file service account — HANYA di luar repository, atau atur via Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/path/ke/service-account.json
